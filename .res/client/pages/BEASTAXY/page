<!-- Proposition -->


<div id="stats">
    <div id="score"></div>
    <div id="action-panel">
        <img alt="stamina action button" src="local/imgs/ui/stamina/0.png" id="stamina">
    </div>
</div>


<div class="vbox mid">
    <div class="block">
        <canvas id="board" width="200" height="200"></canvas>
    </div>

    <div class="hbox">
        <div class="btn block" onclick="send('bPause')">
            <div class="icon">p</div>
        </div>
        <div class="btn block" onclick="send('bRestart')">
            <div class="icon">r</div>
        </div>
        <div class="btn block" onclick="send('bKill')">
            <div class="icon">k</div>
        </div>
    </div>
</div>


<div class="mid top btn block" onclick="transition('25285', [0, 1])">
    <div class="load-svg icon">arrowW</div>
</div>
