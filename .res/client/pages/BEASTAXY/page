<!-- Proposition -->


<div id="stats" class="hidden">
    <div>time&nbsp;<span id="time">&nbsp;</span></div>
    <div>score&nbsp;<span id="score">&nbsp;</span></div>
    <div id="action-panel">
        <img
            id="stamina"
            alt="stamina action button"
            draggable="false"
            src="local/imgs/ui/stamina/0.png">
    </div>
</div>


<div class="vbox mid">
    <div id="board" class="block">
        <canvas width="200" height="200"></canvas>
    </div>

    <div class="hbox">
        <div class="btn block" onclick="call('bPause')">
            <div class="symbol">p</div>
        </div>
        <div class="btn block" onclick="call('bRestart')">
            <div class="symbol">r</div>
        </div>
        <div class="btn block" onclick="call('bKill')">
            <div class="symbol">k</div>
        </div>
        <div class="btn block" onclick="call('bAdd')">
            <div class="symbol">a</div>
        </div>
    </div>
</div>

<div id="menu" class="hidden vbox fill">
    <div class="block">
        <div class="lable text"></div>
        <img
            id="frame"
            alt="animated ending"
            draggable="false"
            src="local/data/defs.svg">
    </div>
    <div id="btn-sets">
        <div id="gameover" class="hidden hbox">
            <div class="btn block">
                <div class="text" onclick="call('bRestart')">try&nbsp;again</div>
            </div>
            <div class="btn block">
                <div class="text">change&nbsp;level</div>
            </div>
        </div>
        <div id="pause" class="hidden hbox">
            <div class="btn block" class="hidden hbox">
                <div class="text" onclick="call('bPause')">continue</div>
            </div>
        </div>
    </div>

    <div class="mid top">
        <div class="btn block" onclick="transition('25285', [0, 1])">
            <div class="load-svg icon">arrowW</div>
        </div>
    </div>
</div>
