<!-- Main Page -->


<div class="vbox mid top">
    <div class="block">
        <div class="icon text lable">INFILAXY</div>
    </div>
    <div class="small btn block" onclick="transition('collection', [0, 1])">
        <div class="load-svg icon">arrowW</div>
    </div>
</div>

<div class="vbox top right">
    <div class="small btn block" onclick="transition('404', [0, 0])">
        <div class="symbol">x</div>
    </div>
    <div class="small btn block" onclick="transition('shutdown', [0, 0])">
        <div class="symbol">!</div>
    </div>
</div>


<div class="vbox mid bot">

    <div class="hbox">
        <div class="small btn block" onclick="transition('4eRn1j_kW@dr4T', [-1, 0])">
            <div class="load-svg icon">arrowA</div>
        </div>
        <div class="small btn block masked" onclick="transition('proposition', [0, -1])">
            <div class="load-svg icon">arrowS</div>
        </div>
        <div class="small btn block" onclick="transition('presentation', [1, 0])">
            <div class="load-svg icon">arrowD</div>
        </div>
    </div>
    
    <div id="player" class="block">
        <div class="hbox">
        
            <div class="btn block active">
                <div class="load-svg icon">arrowA</div>
            </div>
            
            <div class="big btn block" onclick="transition('preview', [0, -1])">
                <div class="load-svg icon">play</div> <!-- спустится с интро -->
            </div>
            
            <div class="btn block hover">
                <div class="load-svg icon">arrowD</div>
            </div>
            
        </div>
    </div>
    
</div>


<div class="hbox mid" id="chars">
    <div id="infi" class="character" ><!--
        style="outline: 2px solid red" 
        -->
        <div class="sprite"></div>
        <div class="anchor"></div>
    </div>
    <div id="virko" class="character" ><!--
        style="outline: 2px solid red" 
        -->
        <div class="sprite"></div>
        <div class="anchor"></div>
    </div>
</div>
