<div id="carousel">
    
    <div id="projector" class="hidden">
        <div id="blanket"></div>
        <div id="control"></div>
    </div>
    
    <div id="audio">
        <table id="cartridges"></table>
        <div id="console"></div>
    </div>
    
    <div id="video" class="hidden">
        <ul id="cassettes">
            <li></li>
